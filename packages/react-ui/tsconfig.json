{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.json",
  "include": ["src/**/*"],
  // Tests must never reach `dist` — it is the published `files` entry. They are
  // still typechecked through `tsconfig.test.json`, which re-includes them.
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["./src/types.d.ts", "node"]
  }
}
